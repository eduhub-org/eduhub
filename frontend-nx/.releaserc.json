{
  "branches": [
    {
      "name": "production",
      "channel": "latest"
    },
    {
      "name": "staging", 
      "prerelease": "rc",
      "channel": "staging"
    },
    {
      "name": "develop",
      "prerelease": "dev",
      "channel": "develop"
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "../CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "echo 'Updating version files for ${nextRelease.version}' && find ../functions -name 'package.json' -exec sed -i 's/\"version\": \"[^\"]*\"/\"version\": \"${nextRelease.version}\"/g' {} \\;",
        "publishCmd": "echo 'Published ${nextRelease.version} on ${nextRelease.channel}'"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "../CHANGELOG.md",
          "package.json",
          "../package.json",
          "../functions/*/package.json"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}