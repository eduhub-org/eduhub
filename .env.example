# Environment Variables for Local Development
# Copy this file to .env and fill in your actual values
# The .env file is gitignored and should not be committed
#
# NOTE: This file is ONLY for local development with docker-compose.
# Staging and production environments use Terraform/Secret Manager for configuration.

# =============================================================================
# Matrix / Element (chat links and room creation)
# =============================================================================
# Public URL of the Element web client (used by the Next.js app for room links).
# No trailing slash required. Example: https://element-chat.example.org
# Staging/production: set the same value as GitHub Actions env var
# NEXT_PUBLIC_MATRIX_ELEMENT_CLIENT_URL on the staging/production environment so
# the frontend Docker image build inlines it (Cloud Run runtime env alone is not enough).
NEXT_PUBLIC_MATRIX_ELEMENT_CLIENT_URL=

# Same base URL for serverless functions (createMatrixRoom, etc.). Often matches
# NEXT_PUBLIC_MATRIX_ELEMENT_CLIENT_URL. Passed to node_functions via docker-compose.
MATRIX_ELEMENT_CLIENT_URL=

# --- createMatrixRoom (node_functions) — required for “Create Matrix room” in Manage Courses ---
# Client API base URL of your Matrix homeserver (Synapse). Example: https://matrix.example.org
MATRIX_HOMESERVER_URL=

# Matrix server name (domain part of room/user IDs), e.g. example.org. Optional if derivable
# from MATRIX_MAIN_SPACE_ID or MATRIX_ADMIN_USER_ID (see functions/callNodeFunction/createMatrixRoom).
MATRIX_SERVER_NAME=

# Room ID of the top-level Space under which program spaces are linked (m.space.child).
MATRIX_MAIN_SPACE_ID=

# Full Matrix user ID of the admin account used for power levels, e.g. @admin:example.org
MATRIX_ADMIN_USER_ID=

# Access token for that admin user (keep secret; never commit real values).
MATRIX_ADMIN_ACCESS_TOKEN=
#
# For existing program subspaces (matrixSpaceId already set), createMatrixRoom joins that
# space as this user before linking course rooms. Join uses room id domain, MATRIX_SERVER_NAME,
# and the hostname of MATRIX_HOMESERVER_URL (Synapse strips duplicate “self” server_name).
# The room must allow join (e.g. public) or you must invite this user into the program space once.
#
# One course room still triggers several Client API calls (join + createRoom + state). If you see
# “Too Many Requests” / HTTP 429, relax Synapse rc_* limits or proxy rate limits for this user/IP.

# =============================================================================
# Formbricks Integration
# =============================================================================
# Base URL of your Formbricks instance
# Example: https://app.formbricks.com or https://your-instance.formbricks.com
FORMBRICKS_API_URL=https://app.formbricks.com

# API Key for accessing the Formbricks Management API
# Get this from: Formbricks → Settings → Organization → API Keys
# Create a new key with "read" permission for your project's environment
# Example: fb_prod_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FORMBRICKS_API_KEY=

# =============================================================================
# Stripe Integration
# =============================================================================
# Stripe Secret Key for API authentication
# Get this from: Stripe Dashboard → Developers → API Keys
# Use test keys (sk_test_...) for local development
# Example: sk_test_51AbCdEfGhIjKlMnOpQrStUvWxYz1234567890
STRIPE_SECRET_KEY=

# Stripe Webhook Secret for webhook signature verification
# IMPORTANT: For local development, use Stripe CLI instead of setting this:
#   Run: stripe listen --forward-to localhost:5000/api/webhooks/stripe
#   The CLI will provide a temporary webhook secret for local testing.
#   You can leave this empty when using Stripe CLI.
#
# NOTE: For staging and production, webhook secrets are configured via Terraform
# (see infrastructure/application/01_secrets.tf and 06_cloud-functions.tf)
#
# Example (only if not using Stripe CLI): whsec_1234567890abcdefghijklmnopqrstuvwxyz
STRIPE_WEBHOOK_SECRET=

# Stripe Publishable Key (safe to expose publicly, used in frontend)
# Get this from: Stripe Dashboard → Developers → API Keys
# Use test keys (pk_test_...) for local development
# Example: pk_test_51AbCdEfGhIjKlMnOpQrStUvWxYz1234567890
STRIPE_PUBLISHABLE_KEY=

# =============================================================================
# Ghost Newsletter Credential Encryption
# =============================================================================
# 32-byte key used to encrypt per-organization Ghost credentials at rest.
# Format: either 64 hex chars or base64 encoded 32-byte value.
# Generate (hex): openssl rand -hex 32
GHOST_NEWSLETTER_CREDENTIALS_ENCRYPTION_KEY=

# =============================================================================
# Guest Registration Manage Links
# =============================================================================
# Secret used to sign the self-service links that let a guest (someone who
# registered for an event without an account) view, cancel or erase their data.
# The link is a stateless HMAC, so anyone holding this secret can mint a valid
# link for any guest - treat it like a signing key, not a config value.
# Generate: openssl rand -hex 32
GUEST_TOKEN_SECRET=

# =============================================================================
# Python serverless functions (callPythonFunction / apiProxy / shared_libs)
# =============================================================================
# Used for attendance, integrations, and local testing against real services.
# docker-compose passes these into the python_functions service via ${VAR} (same
# root .env Compose uses for other services). `functions/dev.py` loads ../.env
# when you run it on the host.

# --- Zoom (Server-to-Server OAuth) — see functions/shared_libs/api_clients/zoom_client.py
# App credentials from Zoom Marketplace → your Server-to-Server OAuth app.
ZOOM_API_KEY=
ZOOM_API_SECRET=
ZOOM_ACCOUNT_ID=
# Optional: connect/read timeout in seconds (single number applies to both).
# ZOOM_HTTP_TIMEOUT_SEC=

# --- LimeSurvey (JSON-RPC API) — see functions/shared_libs/api_clients/limesurvey_client.py
# LMS_URL is the remote procedure endpoint, usually …/index.php/admin/remote.
LMS_URL=
LMS_USER=
LMS_PASSWORD=
# Survey ID used for attendance questionnaire collection.
LMS_ATTENDANCE_SURVEY_ID=

# --- Mattermost (Admin API) — see functions/shared_libs/api_clients/mattermost_client.py
MM_URL=
MM_TOKEN=
