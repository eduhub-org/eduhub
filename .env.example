# Environment Variables for Local Development
# Copy this file to .env and fill in your actual values
# The .env file is gitignored and should not be committed
#
# NOTE: This file is ONLY for local development with docker-compose.
# Staging and production environments use Terraform/Secret Manager for configuration.

# =============================================================================
# Formbricks Integration
# =============================================================================
# Base URL of your Formbricks instance
# Example: https://app.formbricks.com or https://your-instance.formbricks.com
FORMBRICKS_API_URL=https://app.formbricks.com

# API Key for accessing the Formbricks Management API
# Get this from: Formbricks → Settings → Organization → API Keys
# Create a new key with "read" permission for your project's environment
# Example: fb_prod_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FORMBRICKS_API_KEY=

# =============================================================================
# Stripe Integration
# =============================================================================
# Stripe Secret Key for API authentication
# Get this from: Stripe Dashboard → Developers → API Keys
# Use test keys (sk_test_...) for local development
# Example: sk_test_51AbCdEfGhIjKlMnOpQrStUvWxYz1234567890
STRIPE_SECRET_KEY=

# Stripe Webhook Secret for webhook signature verification
# IMPORTANT: For local development, use Stripe CLI instead of setting this:
#   Run: stripe listen --forward-to localhost:5000/api/webhooks/stripe
#   The CLI will provide a temporary webhook secret for local testing.
#   You can leave this empty when using Stripe CLI.
#
# NOTE: For staging and production, webhook secrets are configured via Terraform
# (see infrastructure/application/01_secrets.tf and 06_cloud-functions.tf)
#
# Example (only if not using Stripe CLI): whsec_1234567890abcdefghijklmnopqrstuvwxyz
STRIPE_WEBHOOK_SECRET=

# Stripe Publishable Key (safe to expose publicly, used in frontend)
# Get this from: Stripe Dashboard → Developers → API Keys
# Use test keys (pk_test_...) for local development
# Example: pk_test_51AbCdEfGhIjKlMnOpQrStUvWxYz1234567890
STRIPE_PUBLISHABLE_KEY=

# =============================================================================
# Ghost Newsletter Credential Encryption
# =============================================================================
# 32-byte key used to encrypt per-organization Ghost credentials at rest.
# Format: either 64 hex chars or base64 encoded 32-byte value.
# Generate (hex): openssl rand -hex 32
GHOST_NEWSLETTER_CREDENTIALS_ENCRYPTION_KEY=
