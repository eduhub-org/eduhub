              "children": [
                {
                  "children": [
                    {
                      "content": "## The idea",
                      "fill": "#00C4B8",
                      "fontFamily": "Space Grotesk",
                      "fontSize": 18,
                      "fontWeight": "600",
                      "id": "IEeUL",
                      "name": "Heading",
                      "type": "text"
                    },
                    {
                      "content": "Coastal sensor networks need reliable off-grid power. This project explores a low-cost buoy that converts wave motion into stored energy for nearby IoT devices.",
                      "fill": "#C8C8C8",
                      "fontFamily": "Space Grotesk",
                      "fontSize": 15,
                      "fontWeight": "normal",
                      "id": "ZUclb",
                      "lineHeight": 1.55,
                      "name": "Body",
