                },
                {
                  "children": [
                    {
                      "content": "## What you'll build",
                      "fill": "#00C4B8",
                      "fontFamily": "Space Grotesk",
                      "fontSize": 18,
                      "fontWeight": "600",
                      "id": "ySCtt",
                      "name": "Heading",
                      "type": "text"
                    },
                    {
                      "content": "A waterproof buoy housing, an energy-harvesting mechanism, a charge controller, and a small telemetry dashboard to monitor output over time.",
                      "fill": "#C8C8C8",
                      "fontFamily": "Space Grotesk",
                      "fontSize": 15,
                      "fontWeight": "normal",
                      "id": "q3agxq",
                      "lineHeight": 1.55,
                      "name": "Body",
