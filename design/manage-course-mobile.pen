        {
          "type": "text",
          "id": "I95Hk",
          "name": "Sections get uppercase l",
          "fill": "$label-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Sections get uppercase labels like the expanded session rows. All 2-, 3- and 12-column grids stack to one column, except short pairs (times, language/seats). The learning goals take only the height they need, not a fixed h-64. The info blocks become accordions so the page is not two 256 px editors long. Each location becomes a card with the address on its own row. From md up the page keeps today's 2-column layout.",
          "lineHeight": 1.4,
          "fontFamily": "$font",
          "fontSize": 11,
          "fontWeight": "normal"
        }
      ]
    },
