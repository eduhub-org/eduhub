{
  "name": "callNodeFunction",
  "version": "0.1.0",
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@keycloak/keycloak-admin-client": "26.8.2",
    "graphql-request": "^6.1.0",
    "marked": "^15.0.12",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "stripe": "^22.6.2",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@google-cloud/functions-framework": "^5.0.5",
    "@jest/globals": "^30.5.2",
    "jest": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "js-yaml": "^4.3.2",
    "npm-watch": "^0.13.0"
  },
  "watch": {
    "start": "*.js"
  },
  "scripts": {
    "watch": "npm-watch start",
    "start": "npx @google-cloud/functions-framework --target=${FUNCTION_TARGET:-callNodeFunction}",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1",
    "uuid": "^11.1.1"
  }
}
