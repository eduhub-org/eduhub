## Error Handling and Security

### Authentication Error Handling
```typescript
// utils/authErrors.ts
export class AuthenticationError extends Error {
  constructor(message: string, public code: string) {
    super(message);
    this.name = 'AuthenticationError';
  }
}

export class AuthorizationError extends Error {
  constructor(message: string, public requiredRole: string) {
    super(message);
    this.name = 'AuthorizationError';
  }
}

// Error handler
export const handleAuthError = (error: Error) => {
  if (error instanceof AuthenticationError) {
    signOut();
    return 'Please log in to continue';
  }
  
  if (error instanceof AuthorizationError) {
    return `Access denied. Required role: ${error.requiredRole}`;
  }
  
  return 'An unexpected error occurred';
};
```

### Secure Logging
```typescript
// utils/secureLogging.ts
const sensitiveFields = ['password', 'token', 'email', 'ssn'];

export const sanitizeLogData = (data: any): any => {
  if (typeof data !== 'object' || data === null) {
    return data;
  }
  
  const sanitized = { ...data };
  
  Object.keys(sanitized).forEach(key => {
    if (sensitiveFields.some(field => key.toLowerCase().includes(field))) {
      sanitized[key] = '[REDACTED]';
    } else if (typeof sanitized[key] === 'object') {
      sanitized[key] = sanitizeLogData(sanitized[key]);
    }
  });
  
  return sanitized;
};

export const secureLog = (level: string, message: string, data?: any) => {
  console[level](message, data ? sanitizeLogData(data) : '');
};
```

## Testing Security

### Authentication Testing
```typescript
// __tests__/auth.test.tsx
import { render, screen } from '@testing-library/react';
import { useSession } from 'next-auth/react';
import ProtectedComponent from '../ProtectedComponent';

jest.mock('next-auth/react');

describe('Authentication', () => {
  it('should redirect unauthenticated users', () => {
    (useSession as jest.Mock).mockReturnValue({
      data: null,
      status: 'unauthenticated',
    });

    render(<ProtectedComponent />);
    
    expect(screen.getByText('Please log in')).toBeInTheDocument();
  });

  it('should show content for authenticated users', () => {
    (useSession as jest.Mock).mockReturnValue({
      data: { user: { id: '1', roles: ['PARTICIPANT'] } },
      status: 'authenticated',
    });

    render(<ProtectedComponent />);
    
    expect(screen.getByText('Protected content')).toBeInTheDocument();
  });
});
```

### Authorization Testing
```typescript
describe('Authorization', () => {
  it('should deny access without required role', () => {
    (useSession as jest.Mock).mockReturnValue({
      data: { user: { id: '1', roles: ['PARTICIPANT'] } },
      status: 'authenticated',
    });

    render(<AdminOnlyComponent />);
    
    expect(screen.getByText('Access denied')).toBeInTheDocument();
  });

  it('should allow access with required role', () => {
    (useSession as jest.Mock).mockReturnValue({
      data: { user: { id: '1', roles: ['ADMIN'] } },
      status: 'authenticated',
    });

    render(<AdminOnlyComponent />);
    
    expect(screen.getByText('Admin dashboard')).toBeInTheDocument();
  });
});
```

## Common Security Issues and Solutions

### Token Expiration Handling
```typescript
// Handle expired tokens gracefully
const handleExpiredToken = (error: ApolloError) => {
  if (error.message.includes('JWTExpired')) {
    signOut({ callbackUrl: '/login?message=session-expired' });
  }
};
```

### Permission Errors
```typescript
// Handle permission errors
const handlePermissionError = (error: ApolloError) => {
  if (error.message.includes('permission')) {
    // Log security event
    secureLog('warn', 'Permission denied', {
      userId: session?.user?.id,
      action: 'attempted unauthorized access',
    });
    
    // Show user-friendly message
    showErrorMessage('You do not have permission to perform this action');
  }
};
```

### Secure File Uploads
```typescript
// File upload validation
const validateFileUpload = (file: File): boolean => {
  const allowedTypes = ['image/jpeg', 'image/png', 'application/pdf'];
  const maxSize = 10 * 1024 * 1024; // 10MB
  
  if (!allowedTypes.includes(file.type)) {
    throw new Error('File type not allowed');
  }
  
  if (file.size > maxSize) {
    throw new Error('File too large');
  }
  
  return true;
};
```

