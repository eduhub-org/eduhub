#### Redis Caching (if used)
```typescript
// Example Redis caching for expensive queries
const getCachedCourseStatistics = async (courseId: string) => {
  const cacheKey = `course_stats_${courseId}`;
  
  // Try cache first
  let stats = await redis.get(cacheKey);
  if (stats) {
    return JSON.parse(stats);
  }
  
  // Calculate and cache
  stats = await calculateCourseStatistics(courseId);
  await redis.setex(cacheKey, 300, JSON.stringify(stats)); // 5-minute cache
  
  return stats;
};
```

## Image and Asset Optimization

### Image Loading Strategies
```typescript
// ✅ GOOD: Progressive image loading
const ProgressiveImage: React.FC<{ src: string; alt: string }> = ({ src, alt }) => {
  const [imageLoaded, setImageLoaded] = useState(false);
  const [imageSrc, setImageSrc] = useState('');

  useEffect(() => {
    const img = new window.Image();
    img.onload = () => {
      setImageSrc(src);
      setImageLoaded(true);
    };
    img.src = src;
  }, [src]);

  return (
    <div className="relative">
      {!imageLoaded && (
        <div className="absolute inset-0 bg-gray-200 animate-pulse" />
      )}
      {imageSrc && (
        <img
          src={imageSrc}
          alt={alt}
          className={`transition-opacity duration-300 ${
            imageLoaded ? 'opacity-100' : 'opacity-0'
          }`}
          onLoad={() => setImageLoaded(true)}
        />
      )}
    </div>
  );
};
```

### Asset Preloading
```typescript
// ✅ GOOD: Preload critical resources
const preloadCriticalAssets = () => {
  // Preload critical images
  const criticalImages = ['/logo.svg', '/hero-image.jpg'];
  criticalImages.forEach(src => {
    const link = document.createElement('link');
    link.rel = 'preload';
    link.as = 'image';
    link.href = src;
    document.head.appendChild(link);
  });

  // Preload critical fonts
  const criticalFonts = ['/fonts/inter-var.woff2'];
  criticalFonts.forEach(src => {
    const link = document.createElement('link');
    link.rel = 'preload';
    link.as = 'font';
    link.type = 'font/woff2';
    link.href = src;
    link.crossOrigin = 'anonymous';
    document.head.appendChild(link);
  });
};
```

## Performance Monitoring

### Client-Side Performance Tracking
```typescript
// utils/performance.ts
export const measurePerformance = (name: string, fn: () => void) => {
  const start = performance.now();
  fn();
  const end = performance.now();
  
  console.log(`${name} took ${end - start} milliseconds`);
  
  // Send to analytics if needed
  if (typeof window !== 'undefined' && window.gtag) {
    window.gtag('event', 'timing_complete', {
      name: name,
      value: Math.round(end - start),
    });
  }
};

// Usage
const handleHeavyOperation = () => {
  measurePerformance('heavy-calculation', () => {
    // Heavy operation
    performHeavyCalculation();
  });
};
```

