## GraphQL Performance Optimization

### Query Optimization

#### Efficient Query Structure
```typescript
// ✅ GOOD: Use fragments to avoid duplicating fields
const COURSE_FRAGMENT = gql`
  fragment CourseDetails on Course {
    id
    title
    description
    startTime
    endTime
    maxParticipants
    status
  }
`;

const COURSE_LIST_QUERY = gql`
  ${COURSE_FRAGMENT}
  query CourseList($limit: Int!, $offset: Int!, $where: Course_bool_exp) {
    Course(limit: $limit, offset: $offset, where: $where, order_by: { createdAt: desc }) {
      ...CourseDetails
      instructor {
        id
        firstName
        lastName
      }
    }
    Course_aggregate(where: $where) {
      aggregate {
        count
      }
    }
  }
`;

// ✅ GOOD: Separate minimal query for lists
const COURSE_LIST_MINIMAL = gql`
  query CourseListMinimal($limit: Int!, $offset: Int!) {
    Course(limit: $limit, offset: $offset) {
      id
      title
      status
      startTime
    }
  }
`;
```

#### Pagination and Limiting
```typescript
// ✅ GOOD: Always use pagination for lists
const useCourseList = (pageSize: number = 50) => {
  const [pageIndex, setPageIndex] = useState(0);
  
  const { data, loading, error } = useAdminQuery(COURSE_LIST_QUERY, {
    variables: {
      limit: pageSize,
      offset: pageIndex * pageSize,
    },
    // ✅ GOOD: Cache policy for lists
    fetchPolicy: 'cache-and-network',
  });

  return {
    courses: data?.Course || [],
    totalCount: data?.Course_aggregate?.aggregate?.count || 0,
    pageIndex,
    setPageIndex,
    loading,
    error,
  };
};
```

### Apollo Client Caching

#### Cache Configuration
```typescript
// apolloClient.ts
import { InMemoryCache } from '@apollo/client';

const cache = new InMemoryCache({
  typePolicies: {
    Course: {
      fields: {
        // ✅ GOOD: Pagination caching
        Course: {
          keyArgs: ['where'],
          merge(existing = [], incoming, { args }) {
            const { offset = 0 } = args;
            const merged = existing ? existing.slice() : [];
            
            for (let i = 0; i < incoming.length; ++i) {
              merged[offset + i] = incoming[i];
            }
            
            return merged;
          },
        },
      },
    },
    Query: {
      fields: {
        // ✅ GOOD: Cache list queries separately
        courseList: {
          keyArgs: ['filters'],
          merge(existing, incoming) {
            return incoming;
          },
        },
      },
    },
  },
});
```

#### Smart Cache Updates
```typescript
// ✅ GOOD: Update cache after mutations
const useUpdateCourse = () => {
  const [updateCourseMutation] = useRoleMutation(UPDATE_COURSE_MUTATION, {
    update: (cache, { data }) => {
      if (!data?.update_Course_by_pk) return;

      // Update individual cache entry
      cache.modify({
        id: cache.identify({ __typename: 'Course', id: data.update_Course_by_pk.id }),
        fields: {
          title: () => data.update_Course_by_pk.title,
          description: () => data.update_Course_by_pk.description,
          updatedAt: () => new Date().toISOString(),
        },
      });

      // ✅ GOOD: Invalidate related list queries
      cache.evict({ fieldName: 'Course' });
    },
  });

  return updateCourseMutation;
};
```

#### Query Deduplication
```typescript
// ✅ GOOD: Avoid duplicate queries
const useCourseData = (courseId: string) => {
  return useAdminQuery(COURSE_DETAIL_QUERY, {
    variables: { id: courseId },
    skip: !courseId,
    // ✅ GOOD: Return cached data immediately
    returnPartialData: true,
    // ✅ GOOD: Deduplicate identical queries
    notifyOnNetworkStatusChange: false,
  });
};
```

## Database Performance

### Query Optimization

#### Efficient Hasura Queries
```sql
-- ✅ GOOD: Use proper indexes
CREATE INDEX idx_course_status_start_time ON Course(status, start_time);
CREATE INDEX idx_enrollment_user_course ON CourseEnrollment(user_id, course_id);
CREATE INDEX idx_user_email ON User(email) WHERE email IS NOT NULL;

-- ✅ GOOD: Optimize frequently used queries
CREATE INDEX idx_course_search ON Course USING gin(to_tsvector('english', title || ' ' || description));
```

#### Aggregation Optimization
```typescript
// ✅ GOOD: Use aggregation fields efficiently
const COURSE_STATISTICS = gql`
  query CourseStatistics($courseId: Int!) {
    Course_by_pk(id: $courseId) {
      id
      title
      # ✅ GOOD: Get counts through aggregation
      enrollments_aggregate {
        aggregate {
          count
        }
      }
      sessions_aggregate {
        aggregate {
          count
        }
      }
    }
  }
`;
```

