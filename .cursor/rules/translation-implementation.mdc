      "max_missed_sessions": "Du darfst an maximal einem Termin fehlen",
      "attendance_status": {
        "ATTENDED": "Teilgenommen",
        "MISSED": "Nicht teilgenommen"
      }
    },
    "RegistrationModal": {
      "title_approval": "Für Kurs bewerben",
      "motivation_letter_label": "Motivationsschreiben",
      "cancel": "Abbrechen",
