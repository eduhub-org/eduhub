  const res = {
    status: jest.fn().mockReturnThis(),
    json: jest.fn().mockReturnThis(),
    send: jest.fn().mockReturnThis(),
  };
  return res;
};

export const waitForAsync = () => new Promise(resolve => setTimeout(resolve, 0));

