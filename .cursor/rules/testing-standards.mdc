# Testing Standards

> **Related Rules**: [Frontend Component Patterns](frontend-component-patterns.mdc) | [Component Architecture](component-architecture.mdc) | [GraphQL Integration](graphql-integration-patterns.mdc) | [Frontend Development Commands](frontend-development-commands.mdc)

This guide establishes testing standards, patterns, and best practices for the EduHub codebase across frontend, backend, and serverless functions.

## Testing Framework Overview

### Frontend Testing
- **Framework**: Jest + React Testing Library
- **Configuration**: NX-based Jest configuration
- **Coverage**: Component testing, integration testing, unit testing
- **Related**: See [Frontend Development Commands](frontend-development-commands.mdc) for test commands

### Backend/Serverless Testing
- **Framework**: Jest (Node.js environment)
- **Configuration**: Custom Jest configuration for serverless functions
- **Coverage**: Function testing, API testing, integration testing

## Test Structure and Organization

### Directory Structure

```
project/
├── __tests__/                    # Shared test utilities and mocks
│   ├── helpers/
│   │   ├── mockData.js          # Shared mock data
│   │   ├── testUtils.js         # Test utilities
│   │   └── setup.js             # Test setup
│   └── fixtures/                # Test fixtures
├── components/
│   ├── MyComponent.tsx
│   └── MyComponent.test.tsx     # Co-located test files
├── functions/
│   ├── myFunction/
│   │   ├── index.js
│   │   └── __tests__/
│   │       └── myFunction.test.js
└── jest.config.js               # Jest configuration
```

### File Naming Conventions

- **Test Files**: `*.test.ts`, `*.test.tsx`, `*.test.js`
- **Spec Files**: `*.spec.ts`, `*.spec.tsx`, `*.spec.js`
- **Test Directories**: `__tests__/` for grouped tests
- **Mock Files**: `__mocks__/` for manual mocks

## Frontend Testing Standards

### Component Testing with React Testing Library

#### Basic Component Test Structure

```typescript
import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import { MockedProvider } from '@apollo/client/testing';
import { useSession } from 'next-auth/react';
import MyComponent from './MyComponent';

// Mock external dependencies
jest.mock('next-auth/react');
jest.mock('next-translate/useTranslation', () => () => ({
  t: (key: string) => key,
}));

const mockSession = {
  user: { id: '1', email: 'test@example.com' },
  expires: '2025-01-01',
};

describe('MyComponent', () => {
  beforeEach(() => {
    (useSession as jest.Mock).mockReturnValue({
      data: mockSession,
      status: 'authenticated',
    });
  });

  afterEach(() => {
    jest.clearAllMocks();
  });

  it('should render component with required props', () => {
    render(<MyComponent id={1} />);
    
    expect(screen.getByText('Expected Text')).toBeInTheDocument();
  });

  it('should handle user interactions correctly', async () => {
    render(<MyComponent id={1} />);
    
    const button = screen.getByRole('button', { name: /submit/i });
    fireEvent.click(button);
    
    await waitFor(() => {
      expect(screen.getByText('Success message')).toBeInTheDocument();
    });
  });

  it('should display error state when data loading fails', () => {
    render(<MyComponent id={1} />);
    
    // Simulate error state
    expect(screen.getByText('Error loading data')).toBeInTheDocument();
  });
});
```

#### GraphQL Component Testing

```typescript
import { MockedProvider } from '@apollo/client/testing';
import { render, screen, waitFor } from '@testing-library/react';
import { GET_COURSE_QUERY } from '../../queries/course';
import CourseComponent from './CourseComponent';

const mocks = [
  {
    request: {
      query: GET_COURSE_QUERY,
      variables: { id: 1 },
    },
    result: {
      data: {
        Course_by_pk: {
          id: 1,
          title: 'Test Course',
          description: 'Test Description',
        },
      },
    },
  },
];

describe('CourseComponent', () => {
  it('should render course data when query succeeds', async () => {
    render(
      <MockedProvider mocks={mocks} addTypename={false}>
        <CourseComponent id={1} />
      </MockedProvider>
    );

    await waitFor(() => {
      expect(screen.getByText('Test Course')).toBeInTheDocument();
    });
  });

  it('should handle GraphQL errors gracefully', async () => {
    const errorMocks = [
      {
        request: {
          query: GET_COURSE_QUERY,
          variables: { id: 1 },
        },
        error: new Error('GraphQL error'),
      },
    ];

    render(
      <MockedProvider mocks={errorMocks} addTypename={false}>
        <CourseComponent id={1} />
      </MockedProvider>
    );

    await waitFor(() => {
      expect(screen.getByText('Error loading course')).toBeInTheDocument();
    });
  });
});
```

#### Custom Hook Testing

```typescript
import { renderHook, act } from '@testing-library/react';
import { useRegistrationHandler } from './useRegistrationHandler';

describe('useRegistrationHandler', () => {
  it('should handle successful registration', async () => {
    const mockCourse = { id: 1, title: 'Test Course' };
    const mockOnSuccess = jest.fn();

    const { result } = renderHook(() =>
      useRegistrationHandler({
        course: mockCourse,
        onSuccess: mockOnSuccess,
      })
    );

    await act(async () => {
      await result.current.handleRegistration({
        motivationLetter: 'Test motivation',
      });
    });

    expect(mockOnSuccess).toHaveBeenCalled();
    expect(result.current.isLoading).toBe(false);
  });

  it('should handle registration errors', async () => {
    const mockCourse = { id: 1, title: 'Test Course' };
    const mockOnError = jest.fn();

    const { result } = renderHook(() =>
      useRegistrationHandler({
        course: mockCourse,
        onError: mockOnError,
      })
    );

    // Mock GraphQL error
    jest.spyOn(console, 'error').mockImplementation(() => {});

    await act(async () => {
      await result.current.handleRegistration({
        motivationLetter: 'Test motivation',
      });
    });

    expect(mockOnError).toHaveBeenCalled();
  });
});
```

### TableGrid Testing

```typescript
import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import { MockedProvider } from '@apollo/client/testing';
import TableGrid from '../common/TableGrid';
import { COURSE_LIST_QUERY } from '../../queries/courseList';

const mockData = [
  { id: 1, title: 'Course 1', status: 'ACTIVE' },
  { id: 2, title: 'Course 2', status: 'INACTIVE' },
];

const mocks = [
  {
    request: {
      query: COURSE_LIST_QUERY,
      variables: { limit: 20, offset: 0 },
    },
    result: {
      data: {
        Course: mockData,
        Course_aggregate: { aggregate: { count: 2 } },
      },
    },
  },
];

describe('TableGrid', () => {
  it('should render table with data', async () => {
    render(
      <MockedProvider mocks={mocks} addTypename={false}>
        <TableGrid
          columns={columns}
          data={mockData}
          loading={false}
          error={null}
          totalCount={2}
          pageIndex={0}
          onPageChange={jest.fn()}
          pageSize={20}
          onPageSizeChange={jest.fn()}
        />
      </MockedProvider>
    );

    expect(screen.getByText('Course 1')).toBeInTheDocument();
    expect(screen.getByText('Course 2')).toBeInTheDocument();
  });

  it('should handle pagination correctly', async () => {
    const mockOnPageChange = jest.fn();
    
    render(
      <TableGrid
        columns={columns}
        data={mockData}
        loading={false}
        error={null}
        totalCount={50}
        pageIndex={0}
        onPageChange={mockOnPageChange}
        pageSize={20}
        onPageSizeChange={jest.fn()}
      />
    );

    const nextButton = screen.getByRole('button', { name: /next/i });
    fireEvent.click(nextButton);

    expect(mockOnPageChange).toHaveBeenCalledWith(1);
  });

  it('should handle search functionality', async () => {
    render(
      <TableGrid
        columns={columns}
        data={mockData}
        loading={false}
        error={null}
        searchFilter=""
        onSearchFilterChange={jest.fn()}
        totalCount={2}
        pageIndex={0}
        onPageChange={jest.fn()}
        pageSize={20}
        onPageSizeChange={jest.fn()}
      />
    );

    const searchInput = screen.getByPlaceholderText(/search/i);
    fireEvent.change(searchInput, { target: { value: 'Course 1' } });

    await waitFor(() => {
      expect(screen.getByText('Course 1')).toBeInTheDocument();
      expect(screen.queryByText('Course 2')).not.toBeInTheDocument();
    });
  });
});
```

## Backend/Serverless Testing Standards

### Function Testing Structure

```javascript
import { jest } from '@jest/globals';

// Mock external dependencies
const mockLogger = {
  info: jest.fn(),
  debug: jest.fn(),
  error: jest.fn(),
  warn: jest.fn()
};

describe('myFunction', () => {
  beforeEach(() => {
    jest.clearAllMocks();
  });

  it('should be a function', async () => {
    const { default: myFunction } = await import('../index.js');
    expect(typeof myFunction).toBe('function');
  });

  it('should handle successful execution', async () => {
    const { default: myFunction } = await import('../index.js');
    
    const req = {
      body: {
        // Test request data
      }
    };

    const result = await myFunction(req, mockLogger);
    
    expect(result.success).toBe(true);
    expect(result.data).toBeDefined();
  });

  it('should handle errors gracefully', async () => {
    const { default: myFunction } = await import('../index.js');
    
    const req = {
      body: {
        // Invalid request data
      }
    };

    const result = await myFunction(req, mockLogger);
    
    expect(result.success).toBe(false);
    expect(result.error).toBeDefined();
    expect(mockLogger.error).toHaveBeenCalled();
  });
});
```

### GraphQL Integration Testing

```javascript
import { jest } from '@jest/globals';

// Mock GraphQL client
const mockGraphQLClient = {
  request: jest.fn(),
};

describe('GraphQL Integration', () => {
  beforeEach(() => {
    jest.clearAllMocks();
  });

  it('should fetch user data successfully', async () => {
    const mockUserData = {
      User: {
        id: '1',
        firstName: 'John',
        lastName: 'Doe',
        email: 'john@example.com'
      }
    };

    mockGraphQLClient.request.mockResolvedValue(mockUserData);

    const result = await fetchUserData('1');
    
    expect(result).toEqual(mockUserData);
    expect(mockGraphQLClient.request).toHaveBeenCalledWith(
      expect.stringContaining('query'),
      { userId: '1' }
    );
  });

  it('should handle GraphQL errors', async () => {
    const mockError = new Error('GraphQL error');
    mockGraphQLClient.request.mockRejectedValue(mockError);

    await expect(fetchUserData('1')).rejects.toThrow('GraphQL error');
  });
});
```

