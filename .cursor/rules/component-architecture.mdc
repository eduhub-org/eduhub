  });
});
```

## Performance Optimization

### 1. Memoization Patterns
```typescript
// ✅ GOOD: Memoize expensive calculations
const CourseContent: FC<Props> = ({ course, enrollments }) => {
  const enrollmentStats = useMemo(() => {
    return calculateEnrollmentStats(enrollments);
  }, [enrollments]);

  const handleEnrollmentChange = useCallback((enrollment: Enrollment) => {
    // Handle enrollment change
  }, []);

  return (
    <div>
      <EnrollmentStats stats={enrollmentStats} />
      <EnrollmentList onChange={handleEnrollmentChange} />
    </div>
  );
};
```

### 2. Lazy Loading
```typescript
// ✅ GOOD: Lazy load heavy components
const HeavyStatistics = lazy(() => import('./HeavyStatistics'));

const CourseContent: FC<Props> = ({ course }) => {
  const [showStats, setShowStats] = useState(false);

  return (
    <div>
      <button onClick={() => setShowStats(true)}>
        Show Statistics
      </button>
      {showStats && (
        <Suspense fallback={<CircularProgress />}>
          <HeavyStatistics courseId={course.id} />
        </Suspense>
      )}
    </div>
  );
};
```

## Error Handling Patterns

### 1. Error Boundaries
```typescript
// ✅ GOOD: Component-level error boundaries
class ErrorBoundary extends React.Component<Props, State> {
  constructor(props: Props) {
    super(props);
    this.state = { hasError: false };
  }

  static getDerivedStateFromError(): State {
    return { hasError: true };
  }

  componentDidCatch(error: Error, errorInfo: ErrorInfo) {
    console.error('Component error:', error, errorInfo);
  }

  render() {
    if (this.state.hasError) {
      return <ErrorMessageDialog error="Something went wrong" />;
    }

    return this.props.children;
  }
}
```

### 2. Graceful Degradation
```typescript
// ✅ GOOD: Handle missing data gracefully
const CourseContent: FC<Props> = ({ course }) => {
  if (!course) {
    return <div>Course not found</div>;
  }

  return (
    <div>
      <h1>{course.title || 'Untitled Course'}</h1>
      {course.description && <p>{course.description}</p>}
      {course.sessions?.length > 0 ? (
        <SessionsList sessions={course.sessions} />
      ) : (
        <div>No sessions scheduled</div>
      )}
    </div>
  );
};
```

