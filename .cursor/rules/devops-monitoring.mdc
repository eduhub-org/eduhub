## CI/CD Pipeline

### GitHub Actions Workflow

#### Development Pipeline
```yaml
# .github/workflows/development.yml
name: Development Deployment

on:
  push:
    branches: [develop]

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'yarn'
          cache-dependency-path: frontend-nx/yarn.lock
      
      - name: Install dependencies
        run: |
          cd frontend-nx
          yarn install --frozen-lockfile
      
      - name: Run tests
        run: |
          cd frontend-nx
          yarn test --coverage --watchAll=false
      
      - name: Run linting
        run: |
          cd frontend-nx
          yarn lint
      
      - name: Type check
        run: |
          cd frontend-nx
          yarn type-check

  build:
    needs: test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - name: Build application
        run: |
          cd frontend-nx
          yarn build
      
      - name: Upload build artifacts
        uses: actions/upload-artifact@v4
        with:
          name: build-files
          path: frontend-nx/.next/

  deploy-dev:
    needs: [test, build]
    runs-on: ubuntu-latest
    environment: development
    steps:
      - name: Deploy to development
        run: |
          echo "Deploying to development environment"
          # Add deployment scripts here
```

#### Production Pipeline with Security
```yaml
# .github/workflows/production.yml
name: Production Deployment

on:
  push:
    branches: [production]

jobs:
  security-scan:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - name: Run security audit
        run: |
          cd frontend-nx
          yarn audit --audit-level moderate
      
      - name: Run dependency check
        uses: snyk/actions/node@master
        env:
          SNYK_TOKEN: ${{ secrets.SNYK_TOKEN }}
        with:
          args: --severity-threshold=high

  production-deploy:
    needs: security-scan
    runs-on: ubuntu-latest
    environment: production
    steps:
      - name: Deploy with semantic release
        uses: cycjimmy/semantic-release-action@v4
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
```

### Deployment Strategies

#### Blue-Green Deployment Pattern
```bash
#!/bin/bash
# deploy-blue-green.sh

# Configuration
BLUE_SERVICE="eduhub-blue"
GREEN_SERVICE="eduhub-green"
LOAD_BALANCER="eduhub-lb"

# Determine current active service
CURRENT_ACTIVE=$(docker service inspect --format='{{.Spec.Labels.active}}' $LOAD_BALANCER)

if [ "$CURRENT_ACTIVE" = "blue" ]; then
    DEPLOY_TO="green"
    SWITCH_FROM="blue"
else
    DEPLOY_TO="blue"
    SWITCH_FROM="green"
fi

echo "Deploying to $DEPLOY_TO environment..."

# Deploy new version to inactive environment
docker service update --image eduhub:$NEW_VERSION $DEPLOY_TO

# Health check
echo "Performing health checks..."
for i in {1..30}; do
    if curl -f http://$DEPLOY_TO:3000/health; then
        echo "Health check passed"
        break
    fi
    sleep 10
done

# Switch traffic
echo "Switching traffic from $SWITCH_FROM to $DEPLOY_TO"
docker service update --label-add active=$DEPLOY_TO $LOAD_BALANCER

echo "Deployment completed successfully"
```

