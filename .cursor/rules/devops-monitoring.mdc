#### Request Logging Middleware
```typescript
// middleware/requestLogger.ts
import { NextRequest, NextResponse } from 'next/server';
import logger from '../utils/logger';

export function logRequest(request: NextRequest) {
  const start = Date.now();
  
  // Log request
  logger.info('Request started', {
    method: request.method,
    url: request.url,
    userAgent: request.headers.get('user-agent'),
    ip: request.ip || 'unknown',
    category: 'request',
  });

  return new Promise((resolve) => {
    // Log response (in actual middleware, this would be in the response handler)
    const end = Date.now();
    logger.info('Request completed', {
      method: request.method,
      url: request.url,
      duration: end - start,
      category: 'request',
    });
    resolve(NextResponse.next());
  });
}
```

### Error Tracking

#### Error Boundary with Logging
```typescript
// components/ErrorBoundary.tsx
import React, { Component, ErrorInfo, ReactNode } from 'react';
import logger from '../utils/logger';

interface Props {
  children: ReactNode;
  fallback?: ReactNode;
}

interface State {
  hasError: boolean;
  errorId: string | null;
}

class ErrorBoundary extends Component<Props, State> {
  constructor(props: Props) {
    super(props);
    this.state = { hasError: false, errorId: null };
  }

  static getDerivedStateFromError(error: Error): State {
    const errorId = `error_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
    return { hasError: true, errorId };
  }

  componentDidCatch(error: Error, errorInfo: ErrorInfo) {
    const errorId = this.state.errorId;
    
    // Log error with detailed information
    logger.error('React Error Boundary caught error', {
      errorId,
      message: error.message,
      stack: error.stack,
      componentStack: errorInfo.componentStack,
      category: 'react_error',
      userId: this.getCurrentUserId(), // Implement this method
    });

    // Send to external error tracking service
    this.sendToErrorTracking(error, errorInfo, errorId);
  }

  private getCurrentUserId(): string | undefined {
    // Get current user ID from session/context
    return undefined; // Implement based on your auth system
  }

  private sendToErrorTracking(error: Error, errorInfo: ErrorInfo, errorId: string | null) {
    // Send to service like Sentry, Rollbar, etc.
    if (typeof window !== 'undefined' && window.Sentry) {
      window.Sentry.captureException(error, {
        contexts: {
          react: {
            componentStack: errorInfo.componentStack,
          },
        },
        tags: {
          errorId,
          component: 'ErrorBoundary',
        },
      });
    }
  }

  render() {
    if (this.state.hasError) {
      return this.props.fallback || (
        <div className="error-boundary">
          <h2>Something went wrong</h2>
          <p>Error ID: {this.state.errorId}</p>
          <button onClick={() => this.setState({ hasError: false, errorId: null })}>
            Try again
          </button>
        </div>
      );
    }

    return this.props.children;
  }
}

export default ErrorBoundary;
```

### Performance Monitoring

#### Web Vitals Tracking
```typescript
// utils/analytics.ts
import { getCLS, getFID, getFCP, getLCP, getTTFB, Metric } from 'web-vitals';

export const trackWebVitals = () => {
  const sendToAnalytics = (metric: Metric) => {
    // Log to application logger
    logger.info('Web Vitals metric', {
      name: metric.name,
      value: metric.value,
      rating: metric.rating,
      delta: metric.delta,
      id: metric.id,
      category: 'web_vitals',
    });

    // Send to analytics service
    if (typeof window !== 'undefined' && window.gtag) {
      window.gtag('event', metric.name, {
        value: Math.round(metric.value),
        event_category: 'Web Vitals',
        event_label: metric.id,
        non_interaction: true,
      });
    }
  };

  getCLS(sendToAnalytics);
  getFID(sendToAnalytics);
  getFCP(sendToAnalytics);
  getLCP(sendToAnalytics);
  getTTFB(sendToAnalytics);
};

// Track custom performance metrics
export const trackCustomMetric = (name: string, value: number, metadata?: any) => {
  logger.info('Custom performance metric', {
    name,
    value,
    metadata,
    category: 'custom_performance',
  });
};
```

#### API Performance Monitoring
```typescript
// hooks/usePerformanceMonitoring.ts
import { useEffect } from 'react';
import logger from '../utils/logger';

export const useAPIPerformanceMonitoring = () => {
  useEffect(() => {
    // Monitor GraphQL queries
    const originalFetch = window.fetch;
    
    window.fetch = async (...args) => {
      const start = performance.now();
      const url = args[0]?.toString() || 'unknown';
      
      try {
        const response = await originalFetch(...args);
        const end = performance.now();
        
        logger.info('API request completed', {
          url,
          method: args[1]?.method || 'GET',
          status: response.status,
          duration: end - start,
          category: 'api_performance',
        });
        
        return response;
      } catch (error) {
        const end = performance.now();
        
        logger.error('API request failed', {
          url,
          method: args[1]?.method || 'GET',
          duration: end - start,
          error: error.message,
          category: 'api_error',
        });
        
        throw error;
      }
    };

    return () => {
      window.fetch = originalFetch;
    };
  }, []);
};
```

## Health Checks and Monitoring

### Application Health Endpoints
```typescript
// pages/api/health.ts
import { NextApiRequest, NextApiResponse } from 'next';

interface HealthCheck {
  status: 'healthy' | 'unhealthy';
  checks: {
    database: 'healthy' | 'unhealthy';
    external_apis: 'healthy' | 'unhealthy';
    memory: 'healthy' | 'unhealthy';
  };
  version: string;
  uptime: number;
  timestamp: string;
}

export default async function handler(
  req: NextApiRequest,
  res: NextApiResponse<HealthCheck>
) {
  const startTime = process.hrtime();
  
  try {
    // Check database connectivity
    const databaseStatus = await checkDatabase();
    
    // Check external API dependencies
    const externalApiStatus = await checkExternalAPIs();
    
    // Check memory usage
    const memoryStatus = checkMemoryUsage();
    
    const [seconds, nanoseconds] = process.hrtime(startTime);
    const responseTime = seconds * 1000 + nanoseconds / 1000000;
    
    const health: HealthCheck = {
      status: databaseStatus === 'healthy' && 
               externalApiStatus === 'healthy' && 
               memoryStatus === 'healthy' ? 'healthy' : 'unhealthy',
      checks: {
        database: databaseStatus,
        external_apis: externalApiStatus,
        memory: memoryStatus,
      },
      version: process.env.APP_VERSION || 'unknown',
      uptime: process.uptime(),
      timestamp: new Date().toISOString(),
    };
    
    // Log health check
    logger.info('Health check completed', {
      ...health,
      responseTime,
      category: 'health_check',
    });
    
    const statusCode = health.status === 'healthy' ? 200 : 503;
    res.status(statusCode).json(health);
    
  } catch (error) {
    logger.error('Health check failed', {
      error: error.message,
      category: 'health_check',
    });
    
    res.status(503).json({
      status: 'unhealthy',
      checks: {
        database: 'unhealthy',
        external_apis: 'unhealthy',
        memory: 'unhealthy',
      },
      version: process.env.APP_VERSION || 'unknown',
      uptime: process.uptime(),
      timestamp: new Date().toISOString(),
    });
  }
}

async function checkDatabase(): Promise<'healthy' | 'unhealthy'> {
  try {
    // Implement database connectivity check
    // For example, a simple query to check if database is responsive
    const response = await fetch(process.env.HASURA_ENDPOINT + '/healthz');
    return response.ok ? 'healthy' : 'unhealthy';
  } catch {
    return 'unhealthy';
  }
}

async function checkExternalAPIs(): Promise<'healthy' | 'unhealthy'> {
  try {
    // Check Keycloak health
    const keycloakResponse = await fetch(process.env.KEYCLOAK_URL + '/health', {
      timeout: 5000,
    });
    return keycloakResponse.ok ? 'healthy' : 'unhealthy';
  } catch {
    return 'unhealthy';
  }
}

function checkMemoryUsage(): 'healthy' | 'unhealthy' {
  const memUsage = process.memoryUsage();
  const maxMemory = 512 * 1024 * 1024; // 512MB threshold
  
  return memUsage.heapUsed < maxMemory ? 'healthy' : 'unhealthy';
}
```

