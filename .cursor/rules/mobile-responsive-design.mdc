# Mobile and Responsive Design Guide

> **Related Rules**: [Component Architecture](component-architecture.mdc) | [TableGrid Basic Usage](table-grid-basic-usage.mdc) | [TableGrid Column Configuration](table-grid-column-configuration.mdc) | [Frontend Component Patterns](frontend-component-patterns.mdc)

This guide covers responsive design patterns, mobile optimization, and best practices for creating adaptive user interfaces in EduHub.

## Responsive Design Principles

### Mobile-First Approach
```scss
// ✅ GOOD: Mobile-first CSS approach
.course-card {
  // Base styles for mobile
  padding: 1rem;
  margin-bottom: 1rem;
  
  // Tablet and up
  @media (min-width: 768px) {
    padding: 1.5rem;
    display: flex;
    align-items: center;
  }
  
  // Desktop and up
  @media (min-width: 1024px) {
    padding: 2rem;
    max-width: 1200px;
    margin: 0 auto 2rem;
  }
}
```

### Breakpoint System
```typescript
// utils/breakpoints.ts
export const breakpoints = {
  xs: '0px',
  sm: '640px',
  md: '768px',
  lg: '1024px',
  xl: '1280px',
  '2xl': '1536px',
} as const;

export const useMediaQuery = (query: string) => {
  const [matches, setMatches] = useState(false);

  useEffect(() => {
    const media = window.matchMedia(query);
    const updateMatch = () => setMatches(media.matches);
    
    updateMatch();
    media.addEventListener('change', updateMatch);
    
    return () => media.removeEventListener('change', updateMatch);
  }, [query]);

  return matches;
};

// Usage
const isMobile = useMediaQuery('(max-width: 768px)');
const isTablet = useMediaQuery('(min-width: 768px) and (max-width: 1024px)');
const isDesktop = useMediaQuery('(min-width: 1024px)');
```

## Responsive TableGrid Design

### Mobile TableGrid Patterns

#### Responsive Column Configuration
```typescript
// ✅ GOOD: Mobile-aware column definitions
const useCourseColumns = () => {
  const isMobile = useMediaQuery('(max-width: 768px)');
  const isTablet = useMediaQuery('(min-width: 768px) and (max-width: 1024px)');

  return useMemo<ColumnDef<Course>[]>(() => {
    const baseColumns: ColumnDef<Course>[] = [
      {
        header: 'Course',
        accessorKey: 'title',
        size: isMobile ? 200 : isTablet ? 250 : 300,
        minSize: isMobile ? 150 : 200,
        cell: ({ row }) => (
          <div className="course-cell">
            <div className="font-medium text-sm md:text-base">
              {row.original.title}
            </div>
            {/* Show additional info on mobile */}
            {isMobile && (
              <div className="text-xs text-gray-500 mt-1">
                {formatDate(row.original.startTime)}
              </div>
            )}
          </div>
        ),
      },
    ];

    // Add columns based on screen size
    if (!isMobile) {
      baseColumns.push({
        header: 'Start Date',
        accessorKey: 'startTime',
        size: isTablet ? 120 : 150,
        cell: ({ row }) => (
          <span className="text-sm">
            {formatDate(row.original.startTime)}
          </span>
        ),
      });
    }

    if (isDesktop) {
      baseColumns.push({
        header: 'Description',
        accessorKey: 'description',
        size: 300,
        cell: ({ row }) => (
          <div className="truncate text-sm">
            {row.original.description}
          </div>
        ),
      });
    }

    return baseColumns;
  }, [isMobile, isTablet]);
};
```

#### Mobile-Optimized TableGrid Component
```typescript
// components/common/ResponsiveTableGrid.tsx
interface ResponsiveTableGridProps<T> extends TableGridProps<T> {
  mobileCardRenderer?: (item: T) => React.ReactNode;
  tabletColumns?: ColumnDef<T>[];
  desktopColumns?: ColumnDef<T>[];
}

const ResponsiveTableGrid = <T extends Record<string, any>>({
  data,
  columns,
  mobileCardRenderer,
  tabletColumns,
  desktopColumns,
  ...props
}: ResponsiveTableGridProps<T>) => {
  const isMobile = useMediaQuery('(max-width: 768px)');
  const isTablet = useMediaQuery('(min-width: 768px) and (max-width: 1024px)');

  // Mobile: Use card layout
  if (isMobile && mobileCardRenderer) {
    return (
      <div className="space-y-4">
        {data.map((item, index) => (
          <div key={index} className="mobile-card">
            {mobileCardRenderer(item)}
          </div>
        ))}
        {/* Mobile pagination */}
        <MobilePagination {...props} />
      </div>
    );
  }

  // Tablet/Desktop: Use appropriate columns
  const responsiveColumns = isTablet && tabletColumns 
    ? tabletColumns 
    : !isMobile && desktopColumns 
    ? desktopColumns 
    : columns;

  return (
    <TableGrid
      {...props}
      data={data}
      columns={responsiveColumns}
      className={`responsive-table ${isMobile ? 'mobile' : isTablet ? 'tablet' : 'desktop'}`}
    />
  );
};
```

