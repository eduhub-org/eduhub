  ], []); // ✅ Empty dependency array for static columns

  return (
    <TableGrid
      columns={columns}
      // ... other props
    />
  );
};
```

### Optimized Refetch Filter:

```typescript
const MyComponent: FC = () => {
  const [filters, setFilters] = useState({ programId: 1 });

  const refetchFilter = useCallback(
    (searchTerm: string) => {
      const searchWhere = searchTerm ? { title: { _ilike: `%${searchTerm}%` } } : {};
      return {
        where: {
          ...filters,
          ...searchWhere,
        },
      };
    },
    [filters] // ✅ Only recreate when filters change
  );

  const { data, loading, error } = useTableGrid({
    queryHook: useAdminQuery,
    query: MY_QUERY,
    queryVariables: filters,
    refetchFilter,
  });

  // ... rest of component
};
```

## Common Pitfalls and Solutions

### ❌ Wrong: Offset Conflicts

```typescript
// Don't manage offset manually
const [filter, setFilter] = useState({
  limit: 50,
  offset: 0, // ❌ This conflicts with useTableGrid
  where: { programId: 1 }
});
```

### ✅ Correct: Let useTableGrid Handle Offset

```typescript
// Let useTableGrid calculate offset
const [filter, setFilter] = useState({
  limit: 50,
  // ✅ No offset property
  where: { programId: 1 }
});

// useTableGrid calculates: offset = pageIndex * pageSize
```

### ❌ Wrong: Unsynchronized Page Size

```typescript
const { pageIndex, setPageIndex } = useTableGrid({
  pageSize: 20, // ❌ Hardcoded value
});

return (
  <TableGrid
    pageSize={50} // ❌ Different value!
    pageIndex={pageIndex}
    onPageChange={setPageIndex}
  />
);
```

### ✅ Correct: Synchronized Page Size

```typescript
const [pageSize, setPageSize] = useState(20);

const { pageIndex, setPageIndex } = useTableGrid({
  pageSize: pageSize, // ✅ Same value
});

return (
  <TableGrid
    pageSize={pageSize} // ✅ Same value
    pageIndex={pageIndex}
    onPageChange={setPageIndex}
  />
);
```

## Best Practices Summary

### ✅ DO:
1. **Use `useTableGrid` hook** for data fetching and state management
2. **Synchronize page size** between hook and component
3. **Reset pagination** when filters change
4. **Memoize expensive calculations** and callbacks
5. **Handle errors gracefully** with proper error boundaries
6. **Use appropriate debounce timing** based on query complexity
7. **Combine search with existing filters** using `refetchFilter`

### ❌ AVOID:
1. **Don't manage offset manually** - let useTableGrid handle it
2. **Don't create offset conflicts** with hardcoded values
3. **Don't forget to reset pagination** when filters change
4. **Don't skip memoization** for expensive operations
5. **Don't ignore error handling** - always handle GraphQL errors
6. **Don't use hardcoded page sizes** - make them configurable

This advanced guide covers complex TableGrid usage patterns. For basic setup and configuration, refer to the [TableGrid Basic Usage](table-grid-basic-usage.mdc) guide.