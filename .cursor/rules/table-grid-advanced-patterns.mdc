# TableGrid Advanced Patterns

> **Related Rules**: [TableGrid Basic Usage](table-grid-basic-usage.mdc) | [TableGrid Column Configuration](table-grid-column-configuration.mdc) | [GraphQL Integration](graphql-integration-patterns.mdc) | [Component Architecture](component-architecture.mdc)

This guide covers advanced TableGrid usage patterns including the `useTableGrid` hook, GraphQL integration, complex filtering, and state management.

## useTableGrid Hook

The `useTableGrid` hook ([frontend-nx/apps/edu-hub/components/common/TableGrid/hooks/index.ts](mdc:frontend-nx/apps/edu-hub/components/common/TableGrid/hooks/index.ts)) provides data fetching, search, and pagination state management for TableGrid.

### Hook Interface:

```typescript
interface UseTableGridProps<V> {
  queryHook: (query: DocumentNode, options?: QueryHookOptions) => QueryResult;
  query: DocumentNode;
  queryVariables?: V;
  pageSize?: number;
  debounceMs?: number;
  refetchFilter?: (searchFilter: string) => Record<string, any>;
}
```

### Basic Hook Usage:

```typescript
import { useTableGrid } from '../common/TableGrid/hooks';
import { useAdminQuery } from '../../hooks/authedMutation';
import { MY_QUERY } from '../../queries/myQuery';

const MyComponent: FC = () => {
  const { data, loading, error, searchFilter, pageIndex, setSearchFilter, setPageIndex } = useTableGrid({
    queryHook: useAdminQuery,
    query: MY_QUERY,
    queryVariables: { programId: 1 },
    pageSize: 20,
    debounceMs: 500,
  });

  return (
    <TableGrid
      data={data?.items || []}
      loading={loading}
      error={error}
      searchFilter={searchFilter}
      onSearchFilterChange={setSearchFilter}
      pageIndex={pageIndex}
      onPageChange={setPageIndex}
      // ... other props
    />
  );
};
```

## GraphQL Integration

### Query Structure:

```typescript
// GraphQL query with pagination and aggregation
export const COURSE_LIST = gql`
  query CourseList($limit: Int!, $offset: Int!, $where: Course_bool_exp) {
    Course(limit: $limit, offset: $offset, where: $where, order_by: { createdAt: desc }) {
      id
      title
      description
      createdAt
    }
    Course_aggregate(where: $where) {
      aggregate {
        count
      }
    }
  }
`;
```

### Hook Integration:

```typescript
const MyComponent: FC = () => {
  const { data, loading, error, searchFilter, pageIndex, setSearchFilter, setPageIndex } = useTableGrid({
    queryHook: useAdminQuery,
    query: COURSE_LIST,
    queryVariables: { programId: selectedProgramId },
    pageSize: 50,
    refetchFilter: useCallback(
      (searchTerm: string) => {
        const searchWhere = searchTerm ? { title: { _ilike: `%${searchTerm}%` } } : {};
        return {
          where: {
            programId: { _eq: selectedProgramId },
            ...searchWhere,
          },
        };
      },
      [selectedProgramId]
    ),
  });

  const courses = data?.Course || [];
  const totalCount = data?.Course_aggregate?.aggregate?.count || 0;

  return (
    <TableGrid
      data={courses}
      loading={loading}
      error={error}
      totalCount={totalCount}
      searchFilter={searchFilter}
      onSearchFilterChange={setSearchFilter}
      pageIndex={pageIndex}
      onPageChange={setPageIndex}
      // ... other props
    />
  );
};
```

## Advanced Search and Filtering

### Multi-Field Search:

```typescript
const { searchFilter, setSearchFilter } = useTableGrid({
  queryHook: useAdminQuery,
  query: USER_LIST,
  queryVariables: { role: 'STUDENT' },
  refetchFilter: useCallback(
    (searchTerm: string) => {
      if (!searchTerm) return {};
      
      return {
        where: {
          _or: [
            { firstName: { _ilike: `%${searchTerm}%` } },
            { lastName: { _ilike: `%${searchTerm}%` } },
            { email: { _ilike: `%${searchTerm}%` } },
          ],
        },
      };
    },
    []
  ),
});
```

### Complex Filtering with Multiple Conditions:

```typescript
const MyComponent: FC = () => {
  const [filters, setFilters] = useState({
    programId: null,
    status: 'ACTIVE',
    dateRange: null,
  });

  const { data, loading, error, searchFilter, pageIndex, setSearchFilter, setPageIndex } = useTableGrid({
    queryHook: useAdminQuery,
    query: COURSE_LIST,
    queryVariables: filters,
    pageSize: 25,
    refetchFilter: useCallback(
      (searchTerm: string) => {
        const searchWhere = searchTerm ? { title: { _ilike: `%${searchTerm}%` } } : {};
        const dateWhere = filters.dateRange ? {
          createdAt: {
            _gte: filters.dateRange.start,
            _lte: filters.dateRange.end,
          },
        } : {};

        return {
          where: {
            ...filters,
            ...searchWhere,
            ...dateWhere,
          },
        };
      },
      [filters]
    ),
  });

  const handleFilterChange = useCallback((newFilters) => {
    setFilters(newFilters);
    setPageIndex(0); // Reset pagination when filters change
  }, [setPageIndex]);

  return (
    <div>
      <FilterControls filters={filters} onFilterChange={handleFilterChange} />
      <TableGrid
        data={data?.Course || []}
        loading={loading}
        error={error}
        searchFilter={searchFilter}
        onSearchFilterChange={setSearchFilter}
        pageIndex={pageIndex}
        onPageChange={setPageIndex}
        // ... other props
      />
    </div>
  );
};
```

## State Management Patterns

### Synchronized Page Size:

```typescript
const MyComponent: FC = () => {
  const [pageSize, setPageSize] = useState(20);

  const { pageIndex, setPageIndex } = useTableGrid({
    queryHook: useAdminQuery,
    query: MY_QUERY,
    pageSize: pageSize, // ✅ Synchronized
    queryVariables: { programId: 1 },
  });

  const handlePageSizeChange = useCallback((newPageSize: number) => {
    setPageSize(newPageSize);
    setPageIndex(0); // ✅ Reset pagination
  }, [setPageIndex]);

  return (
    <TableGrid
      pageSize={pageSize} // ✅ Same value
      onPageSizeChange={handlePageSizeChange}
      pageIndex={pageIndex}
      onPageChange={setPageIndex}
      // ... other props
    />
  );
};
```

### Filter State Management:

```typescript
const MyComponent: FC = () => {
  const [baseFilter, setBaseFilter] = useState({
    programId: 1,
    status: 'ACTIVE',
  });

  const { data, loading, error, searchFilter, pageIndex, setSearchFilter, setPageIndex } = useTableGrid({
    queryHook: useAdminQuery,
    query: COURSE_LIST,
    queryVariables: baseFilter,
    pageSize: 30,
    refetchFilter: useCallback(
      (searchTerm: string) => {
        const searchWhere = searchTerm ? { title: { _ilike: `%${searchTerm}%` } } : {};
        return {
          where: {
            ...baseFilter,
            ...searchWhere,
          },
        };
      },
      [baseFilter]
    ),
  });

  const handleBaseFilterChange = useCallback((newFilter) => {
    setBaseFilter(newFilter);
    setPageIndex(0); // ✅ Reset pagination
    setSearchFilter(''); // ✅ Clear search
  }, [setPageIndex, setSearchFilter]);

  return (
    <div>
      <FilterControls filter={baseFilter} onFilterChange={handleBaseFilterChange} />
      <TableGrid
        data={data?.Course || []}
        loading={loading}
        error={error}
        searchFilter={searchFilter}
        onSearchFilterChange={setSearchFilter}
        pageIndex={pageIndex}
        onPageChange={setPageIndex}
        // ... other props
      />
    </div>
  );
};
```

## Debounce Configuration

### Configurable Debounce Timing:

```typescript
// Fast response for simple queries
const { searchFilter, setSearchFilter } = useTableGrid({
  queryHook: useAdminQuery,
  query: SIMPLE_QUERY,
  debounceMs: 300, // ✅ Fast response
  // ... other props
});

// Slower response for complex queries
const { searchFilter, setSearchFilter } = useTableGrid({
  queryHook: useAdminQuery,
  query: COMPLEX_QUERY,
  debounceMs: 1000, // ✅ Conservative for expensive queries
  // ... other props
});
```

### Recommended Debounce Times:

- **300ms**: Default, good for most cases
- **600ms**: Slower typing, less aggressive
- **1000ms**: Very conservative, good for expensive queries

## Error Handling

### GraphQL Error Handling:

```typescript
const MyComponent: FC = () => {
  const { data, loading, error, searchFilter, pageIndex, setSearchFilter, setPageIndex } = useTableGrid({
    queryHook: useAdminQuery,
    query: MY_QUERY,
    queryVariables: { programId: 1 },
    onError: (error) => {
      console.error('TableGrid query error:', error);
      // Handle specific error types
      if (error.message.includes('permission')) {
        showPermissionError();
      } else {
        showGenericError();
      }
    },
  });

  if (error) {
    return <ErrorMessageDialog error={error} />;
  }

  return (
    <TableGrid
      data={data?.items || []}
      loading={loading}
      error={error}
      searchFilter={searchFilter}
      onSearchFilterChange={setSearchFilter}
      pageIndex={pageIndex}
      onPageChange={setPageIndex}
      // ... other props
    />
  );
};
```

